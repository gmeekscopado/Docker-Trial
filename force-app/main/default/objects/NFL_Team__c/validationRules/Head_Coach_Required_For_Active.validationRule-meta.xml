<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Head_Coach_Required_For_Active</fullName>
    <active>true</active>
    <description>Head Coach is required when Active is checked.</description>
    <errorConditionFormula>AND(Active__c = true, ISBLANK(Head_Coach__c))</errorConditionFormula>
    <errorDisplayField>Head_Coach__c</errorDisplayField>
    <errorMessage>Head Coach is required when the team is Active.</errorMessage>
</ValidationRule>
